[meta]
name = "sqlite3"
description = "SQLite 数据库的命令行交互工具"
url = ""

examples = []

[[hit]]
command = "sqlite3 <db_file>"
description = "打开 SQLite 数据库文件"

[[hit]]
command = "sqlite> .databases"
description = "查看当前连接的数据库列表"

[[hit]]
command = "sqlite> .tables"
description = "查看数据库中的所有表名"

[[hit]]
command = "sqlite> .schema <table>"
description = "查看表结构"

[[hit]]
command = "sqlite> .dump <table>"
description = "查看表内容"

[[hit]]
command = "sqlite3 sqlite.db .dump | grep \"<keyword>\""
description = "从数据库中搜索指定字段信息"
