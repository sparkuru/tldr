[meta]
name = "pandoc"
description = "用于文档格式互相转换的命令行工具"
url = ""

examples = []

[[hit]]
command = "pandoc --print-default-data-file reference.docx > template.docx"
description = "输出 pandoc 内置的 docx template，然后可以基于修改后的 custom-reference.docx 去转换文档"

[[hit]]
command = "pandoc -f markdown -t docx --reference-doc <reference.docx> --output <output.docx> <input.md>"
description = "基于 docx 模版将 markdown 文件转换为 docx"
