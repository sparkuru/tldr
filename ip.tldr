examples = []
[[hit]]
command = "ip route replace default via 192.168.9.1 dev eth0 proto static metric 900"
description = "修改路由优先级"

[[hit]]
command = "ip route flush cache"
description = "手动清除路由缓存"

[[hit]]
command = "ip route get <ip>"
description = "手动测试到指定 ip 的路由"

[[hit]]
command = "ip -s link"
description = "查看当前网卡 io 情况"

[meta]
name = "ip"
description = "管理网络接口和路由的工具"
url = "https://man7.org/linux/man-pages/man8/ip.8.html"
