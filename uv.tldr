[meta]
name = "uv"
description = "基于 Rust 的高速 Python 包和项目管理工具"
url = ""

examples = []

[[hit]]
command = "uv venv --python 3.10.8"
description = "创建指定版本的 Python 虚拟环境"

[[hit]]
command = "uv pip install fastapi"
description = "在 uv 虚拟环境中安装 Python 包"

[[hit]]
command = "uv pip install -r requirements.txt"
description = "从 requirements.txt 安装依赖"

[[hit]]
command = "uv init; uv add ipython; uv run ipython"
description = "快速初始化 uv 环境并测试"
