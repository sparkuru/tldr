examples = []
[[hit]]
command = "ssh -oHostKeyAlgorithms=+ssh-rsa -oPubkeyAcceptedAlgorithms=+ssh-rsa <user>@<host>"
description = "解决有的 ssh-server 版本过老导致的算法不支持问题"

[[hit]]
command = "ssh -J middle@192.168.9.1 -p2222 target@172.16.7.1"
description = "通过 ssh jump，将 middle 作为跳板，直接访问 target"

[[hit]]
command = "ssh -J middle1@192.168.9.1,middle2@172.16.7.1:10022 -p2222 target@10.10.10.1"
description = "通过 ssh jump，将 middle1、middle2 作为跳板，直接访问 target"

[[hit]]
command = "ssh -J middle1@192.168.9.1,middle2@172.16.7.1 -p2222 middle3@10.10.10.1 -L 8443:10.10.10.2:443"
description = "通过 ssh jump，将 middle1、middle2、middle3 作为跳板，访问内网 10.10.10.2:443 上的服务，本地访问 https://127.0.0.1:8443 即可"

[meta]
name = "ssh"
description = "用于远程登录和加密通信的安全 Shell 工具"
url = "https://man7.org/linux/man-pages/man1/ssh.1.html"
examples = []
