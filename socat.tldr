[meta]
name = "socat"
description = "用于在两个数据流之间建立双向通道的网络工具"
url = ""

examples = []

[[hit]]
command = "socat udp4-recvfrom:<local_port>,fork,reuseaddr udp4-sendto:<target_ip>:<target_port>"
description = "在中转机器中转发 UDP 报文"

[[hit]]
command = "socat tcp:<local_port>,fork,reuseaddr tcp-sendto:<target_ip>:<target_port>"
description = "在中转机器中转发 TCP 报文"
