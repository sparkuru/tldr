[meta]
name = "nmcli"
description = "用于管理 NetworkManager 网络连接的命令行工具"
url = "https://man7.org/linux/man-pages/man1/nmcli.1.html"

examples = []

[[hit]]
command = "nmcli dev wifi hotspot ifname <interface> ssid <ssid> password <password>"
description = "创建 Wi-Fi 热点"

[[hit]]
command = "nmcli con show"
description = "查看连接信息"

[[hit]]
command = "nmcli connection modify <connection_name> ipv4.addresses 192.168.9.1/24"
description = "为指定连接设置静态 IP 地址"

[[hit]]
command = "nmcli dev wifi list"
description = "扫描周围的 Wi-Fi 信息"
