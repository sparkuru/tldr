[meta]
name = "wireshark"
description = "网络流量捕获和分析的图形化工具"
url = ""

examples = []

[[hit]]
command = "ssh -o HostKeyAlgorithms=+ssh-rsa <user>@<host> \"tcpdump -U -s0 -w - -i <interface>\" | wireshark -k -i -"
description = "通过 ssh 管道将远程 tcpdump 数据传入 wireshark 实时分析，`HostKeyAlgorithms=+ssh-rsa` 表示支持旧版本设备"
